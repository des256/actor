FROM nvcr.io/nvidia/l4t-jetpack:r36.4.0
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y python3.10 python3-pip python3-venv git git-lfs curl wget cmake vim libopenmpi-dev ccache
RUN git lfs install

# TensorRT-LLM 0.14.0
RUN git clone https://github.com/NVIDIA/TensorRT-LLM.git
WORKDIR /TensorRT-LLM
RUN git checkout v0.14.0
RUN git submodule update --init --recursive
RUN git lfs pull
#RUN sed -i 's/tensorrt~=/# &/' requirements.txt
#RUN sed -i 's/torch>=/# &/' requirements.txt
#RUN sed -i 's/pynvml.__version__/getattr(pynvml,"__version__","99.0.0")/' /TensorRT-LLM/tensorrt_llm/profiler.py
#RUN sed -i 's/pynvml.__version__/getattr(pynvml,"__version__","99.0.0")/' /TensorRT-LLM/tensorrt_llm/auto_parallel/cluster_info.py
#RUN pip show torch | grep ^Version | cut -d' ' -f2 | xargs -I{} sh -c 'echo "torch=={}"' >/tmp/constraints.txt
#ENV PIP_CONSTRAINT=/tmp/constraints.txt
#RUN apt install -y libcudnn9-cuda-12 libcudnn9-dev-cuda-12 libopenblas-dev libcusparselt0 libcusparselt-dev
#COPY libnvdla_compiler.so /usr/lib/aarch64-linux-gnu/
#COPY libnvcudla.so /usr/lib/aarch64-linux-gnu/
RUN python3 ./scripts/build_wheel.py --build_type Release -a "87" --install --job_count 4 --use_ccache
#ENV PIP_CONSTRAINT=
RUN pip install /TensorRT-LLM/build/tensorrt_llm-0.14.0-cp310-cp310-linux_aarch64.whl
RUN ldconfig -n /usr/local/lib/python3.10/dist-packages/tensorrt_llm/libs
#RUN rm /usr/local/cuda/lib64/stubs/libcuda.so.1
WORKDIR /

# Rust (could be moved to earlier stage)
