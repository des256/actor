FROM nvcr.io/nvidia/l4t-jetpack:r36.4.0
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y python3.10 python3-pip python3-venv git git-lfs curl wget cmake vim ccache libopenmpi-dev
RUN git lfs install

# TensorRT 10.7
COPY TensorRT-10.7.0.23.l4t.aarch64-gnu.cuda-12.6.tar.gz /opt/
RUN tar -xzvf /opt/TensorRT-10.7.0.23.l4t.aarch64-gnu.cuda-12.6.tar.gz -C /opt/
RUN rm /opt/TensorRT-10.7.0.23.l4t.aarch64-gnu.cuda-12.6.tar.gz
WORKDIR /opt/TensorRT-10.7.0.23/python
RUN python3 -m pip install tensorrt-10.7.0-cp310-none-linux_aarch64.whl
WORKDIR /
RUN cp /opt/TensorRT-10.7.0.23/include/* /usr/include/aarch64-linux-gnu/
RUN cp -R /opt/TensorRT-10.7.0.23/lib/* /usr/lib/aarch64-linux-gnu/
ENV TRT_PATH=/opt/TensorRT-10.7.0.23
ENV PATH=$TRT_PATH/bin:$PATH
ENV LD_LIBRARY_PATH=$TRT_PATH/lib:$LD_LIBRARY_PATH

# NCCL 2.21.5-1
RUN git clone https://github.com/NVIDIA/nccl.git -b v2.21.5-1
WORKDIR /nccl
RUN make -j4 src.build CUDA_HOME=/usr/local/cuda NVCC_GENCODE="-gencode=arch=compute_87,code=sm_87"
RUN make install PREFIX=/usr/local
WORKDIR /
RUN rm -rf nccl
ENV NCCL_ROOT=/usr/local
ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

# PyTorch 2.5.0a0
RUN pip install https://developer.download.nvidia.com/compute/redist/jp/v61/pytorch/torch-2.5.0a0+872d972e41.nv24.08.17622132-cp310-cp310-linux_aarch64.whl

# TensorRT-LLM 0.14.0
RUN git clone https://github.com/NVIDIA/TensorRT-LLM.git
WORKDIR /TensorRT-LLM
RUN git checkout v0.14.0
RUN git submodule update --init --recursive
RUN git lfs pull
RUN sed -i 's/tensorrt~=/# &/' requirements.txt
RUN sed -i 's/torch>=/# &/' requirements.txt
RUN sed -i 's/pynvml.__version__/getattr(pynvml,"__version__","99.0.0")/' /TensorRT-LLM/tensorrt_llm/profiler.py
RUN sed -i 's/pynvml.__version__/getattr(pynvml,"__version__","99.0.0")/' /TensorRT-LLM/tensorrt_llm/auto_parallel/cluster_info.py
RUN pip show torch | grep ^Version | cut -d' ' -f2 | xargs -I{} sh -c 'echo "torch=={}"' >/tmp/constraints.txt
ENV PIP_CONSTRAINT=/tmp/constraints.txt
RUN apt install -y libcudnn9-dev-cuda-12 libopenblas-dev
RUN dpkg -i https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/arm64/libcusparselt0_0.7.1.0-1_arm64.deb
RUN dpkg -i https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/arm64/libcusparselt-dev_0.7.1.0-1_arm64.deb
RUN dpkg -i https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/arm64/libcusparse-12-6_12.5.4.2-1_arm64.deb
RUN dpkg -i https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/arm64/libcusparse-dev-12-6_12.5.4.2-1_arm64.deb
#COPY libnvdla_compiler.so /usr/lib/aarch64-linux-gnu/
#COPY libnvcudla.so /usr/lib/aarch64-linux-gnu/
RUN python3 ./scripts/build_wheel.py --build_type Release -a "87" --install --job_count 4 --use_ccache
ENV PIP_CONSTRAINT=
RUN pip install /TensorRT-LLM/build/tensorrt_llm-0.14.0-cp310-cp310-linux_aarch64.whl
RUN ldconfig -n /usr/local/lib/python3.10/dist-packages/tensorrt_llm/libs
#RUN rm /usr/local/cuda/lib64/stubs/libcuda.so.1
WORKDIR /

# Rust (could be moved to earlier stage)
#RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
#RUN source ~/.cargo/ENV
#RUN apt-get install -y pkg-config libasound2-dev libpulse-dev

